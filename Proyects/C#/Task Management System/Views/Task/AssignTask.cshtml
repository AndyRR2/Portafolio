@{ 
    ViewData["Title"] = "Assign TasK";
}

@model Proyect.ViewModels.AssignTaskViewModel

<h1>@ViewData["Title"]</h1>
<form asp-controller="TasK" asp-action="AssignTaskFromForm" method="post">
    <input hidden asp-for="@Model.Id">
    <div class="form-group" style="max-width: 200px;">
        <label asp-for="@Model.IdAssignedUser"></label>
        <select asp-for="@Model.IdAssignedUser" class="form-control">
            <option value="">Select Id</option>
            @foreach (var idUser in Model.IdUsers)
            {
                <option value="@idUser">@idUser</option>
            }
        </select>
        <span asp-validation-for="@Model.IdAssignedUser" class="text-danger"></span>
    </div>
    <div class="form-group" style="margin-top: 10px;">
        <button type="submit" class="btn btn-primary">Send</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }