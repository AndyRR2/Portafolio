@{ 
    ViewData["Title"] = "Change TasK Status";
}

@model Proyect.ViewModels.EditTaskViewModel

<h1>@ViewData["Title"]</h1>
<form asp-controller="TasK" asp-action="ChangeStatusFromForm" method="post">
    <input hidden asp-for="@Model.Id">
    <input hidden asp-for="@Model.IdBoard">
    <input hidden asp-for="@Model.Name">
    <input hidden asp-for="@Model.Description">
    <input hidden asp-for="@Model.Color">
    <div class="form-group" style="max-width: 200px;">
        <label asp-for="@Model.TaskStat"></label>
        <select asp-for="@Model.TaskStat" asp-items="Html.GetEnumSelectList<TaskStat>()" class="form-control">
            <option value="">Select Status</option>
        </select>
        <span asp-validation-for="@Model.TaskStat" class="text-danger"></span> 
    </div>
    <div class="form-group" style="margin-top: 10px;">
        <button type="submit" class="btn btn-primary">Send</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }