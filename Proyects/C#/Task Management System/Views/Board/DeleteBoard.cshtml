@{ 
    ViewData["Title"] = "Delete Board";
}

@model Proyect.Models.Board

<h2>Confirm deleting</h2>

<form asp-controller="Board" asp-action="DeleteBoardFromForm">
    <input name="idBoardToDelete" type="hidden" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
</form>